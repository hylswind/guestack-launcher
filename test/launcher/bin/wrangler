#!/usr/bin/env node
// Dev-only stand-in for wrangler in the launcher tests. Implements exactly the two commands the
// launcher uses and fails on anything else:
//   wrangler pages secret put NAME --project-name P          (value on stdin)
//   wrangler pages deploy DIR --project-name P --branch main --commit-dirty=true --commit-hash SHA
// It talks to the mock Cloudflare server at MOCK_CF_BASE and requires the credentials wrangler
// would need. A deploy snapshots every file under the working directory (configs included).
import { readdirSync, readFileSync, statSync } from "node:fs";
import { join, relative } from "node:path";

const fail = (msg) => {
  process.stderr.write(`wrangler-shim: ${msg}\n`);
  process.exit(1);
};
const base = process.env.MOCK_CF_BASE;
if (!base) fail("MOCK_CF_BASE not set");
if (!process.env.CLOUDFLARE_API_TOKEN || !process.env.CLOUDFLARE_ACCOUNT_ID) fail("missing CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID");

const args = process.argv.slice(2);
const flag = (name) => {
  const i = args.indexOf(name);
  return i === -1 ? undefined : args[i + 1];
};
const project = flag("--project-name");
const post = async (path, body) => {
  const res = await fetch(`${base}${path}`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
  if (!res.ok) fail(`${path} → ${res.status} ${await res.text()}`);
  return res.json();
};

if (args[0] === "pages" && args[1] === "secret" && args[2] === "put" && project) {
  const chunks = [];
  for await (const c of process.stdin) chunks.push(c);
  await post("/__secrets", { project, name: args[3], value: Buffer.concat(chunks).toString("utf8") });
  process.stdout.write(`✨ Success! Uploaded secret ${args[3]}\n`);
} else if (args[0] === "pages" && args[1] === "deploy" && project) {
  if (process.env.MOCK_WRANGLER_FAIL === `deploy:${project}`) fail("simulated deploy failure");
  if (flag("--branch") !== "main" || !args.includes("--commit-dirty=true") || !flag("--commit-hash")) fail("unexpected deploy flags");
  const root = process.cwd();
  const deployDir = join(root, args[2]);
  statSync(deployDir);
  const files = {};
  const walk = (dir) => {
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
      if (entry.name === ".wrangler" || entry.name === "node_modules") continue;
      const p = join(dir, entry.name);
      if (entry.isDirectory()) walk(p);
      else files[relative(root, p)] = readFileSync(p, "utf8");
    }
  };
  walk(root);
  const { url } = await post("/__deploy", { project, dir: args[2], files });
  process.stdout.write(`✨ Deployment complete! Take a peek over at ${url}\n`);
} else {
  fail(`unsupported command: ${args.join(" ")}`);
}
